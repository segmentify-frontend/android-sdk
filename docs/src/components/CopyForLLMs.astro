---
// "Copy for LLMs": copies this page as Markdown (served next to the page as
// `<page>.md`, see src/pages/[...slug].md.ts) so it can be pasted into an LLM.
import { markdownPath } from '../lib/llm-markdown';

const { entry } = Astro.locals.starlightRoute;
const href = markdownPath(entry);
const llmsTxt = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}llms.txt`;
---

<div class="copy-for-llms not-content">
  <button type="button" class="copy-for-llms-button" data-href={href}>
    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
    </svg>
    <span class="copy-for-llms-label">Copy for LLMs</span>
  </button>
  <a href={href} class="copy-for-llms-link">View as Markdown</a>
  <a href={llmsTxt} class="copy-for-llms-link">llms.txt</a>
</div>

<script>
  const LABEL = 'Copy for LLMs';

  function flash(label: HTMLElement, text: string) {
    label.textContent = text;
    window.setTimeout(() => {
      label.textContent = LABEL;
    }, 2000);
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-for-llms-button')) {
    button.addEventListener('click', async () => {
      const label = button.querySelector<HTMLElement>('.copy-for-llms-label');
      const href = button.dataset.href;
      if (!label || !href) return;
      try {
        const response = await fetch(href);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        await navigator.clipboard.writeText(await response.text());
        flash(label, 'Copied');
      } catch {
        // Clipboard or network not available. A window.open() here, after an await, would be
        // blocked as a pop-up, so point to the "View as Markdown" link instead.
        flash(label, 'Copy failed, use View as Markdown');
      }
    });
  }
</script>

<style>
  .copy-for-llms {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm, 0.875rem);
  }

  .copy-for-llms-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    background: transparent;
    color: var(--sl-color-white);
    font: inherit;
    cursor: pointer;
  }

  .copy-for-llms-button:hover {
    background: var(--sl-color-gray-6);
  }

  .copy-for-llms-link {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }

  .copy-for-llms-link:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
  }
</style>
